---
import { Image } from "astro:assets";
import Container from "../Container.astro";
import Hero from "../../assets/images/hero.jpg";
---

<!--Sección de color rosa -->
<section
  id="inicio"
  class="min-h-screen bg-linear-to-b from-pink-200 to-pink-100"
>
  <Container
    class="flex flex-col lg:flex-row justify-center items-center min-h-screen gap-16 lg:gap-8"
  >
    <div
      class="min-h-screen lg:min-h-0 flex flex-col items-center justify-center text-indigo-950 space-y-8 text-center lg:text-left flex-1 pt-16"
    >
      <h1 class="text-4xl md:text-5xl font-serif font-semibold leading-tight">
        La comida más deliciosa y divertida, <span class="text-fuchsia-500"
          >directo al salón de clases para festejar a tu hij@.</span
        >
      </h1>
      <p class="text-xl lg:text-2xl leading-tight">
        Ofrecemos lunch box para escuelas. Cuidamos cada detalle para que sea un
        día especial. Permítenos ser parte de su celebración.
      </p>
      <div class="flex gap-4 justify-center lg:justify-start">
        <a
          href="#menu"
          class="px-8 py-2 bg-indigo-950 text-white rounded-full font-semibold text-xl lg:text-2xl hover:bg-indigo-800 transition duration-300"
        >
          Ver menú
        </a>
      </div>
    </div>
    <div class="hidden lg:block lg:flex-1 p-8">
      <Image
        loading="eager"
        src={Hero}
        alt="Imagen de un lunch box de My Lunch Box."
        class="mx-auto rounded-2xl w-72 lg:w-150 h-auto rotate-6"
      />
    </div>
  </Container>
</section>
